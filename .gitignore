# 编译产物
[0-99]*

# 但不要忽略以数字开头的 .c 和 .h 源文件
![0-99]*.c
![0-99]*.h

# 忽略其他编译产物
a.out
*.o
*.out
*.tmp
*.exe
*.obj
*.i

# Windows 区域标识文件
*:Zone.Identifier

# VS Code 配置
.vscode/

# 忽略 study 目录下的编译产物
study/**/*.o
study/**/*.out
study/**/*.exe
study/**/a.out

# 无扩展名的 ELF 编译产物（ARM/x86 可执行文件）
LCD
rgb_serial
c/lianxi/rgb
c/lianxi/rgb_arm
